rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // MODELO DE ACCESO (menor privilegio, denegar por defecto)
    //   ADMIN -> lectura y escritura total
    //   cualquier otro rol (user, DESACTIVADO, sin perfil) -> sin acceso
    // El rol vive en users/{uid}.role y solo un ADMIN puede asignarlo.
    // Toda colección no listada aquí queda denegada.
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return exists(userDoc()) ? get(userDoc()).data.get('role', '') : '';
    }

    function isAdmin() {
      return isSignedIn() && role() == 'ADMIN';
    }

    function validRole(r) {
      return r in ['ADMIN', 'DESACTIVADO'];
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    function isNonNegativeNumber(v) {
      return (v is int || v is float) && v >= 0;
    }

    // --- USUARIOS ---
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Solo un ADMIN crea perfiles y asigna roles (no hay auto-registro)
      allow create: if isAdmin()
                    && validRole(request.resource.data.role)
                    && isNonEmptyString(request.resource.data.nombre, 100);
      // Solo ADMIN modifica perfiles (nombre y rol)
      allow update: if isAdmin()
                    && validRole(request.resource.data.role)
                    && isNonEmptyString(request.resource.data.nombre, 100);
      allow delete: if false;
    }

    // --- PRODUCTOS ---
    match /productos/{productoId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && isNonEmptyString(request.resource.data.nombre, 200)
                            && isNonNegativeNumber(request.resource.data.stock)
                            && isNonNegativeNumber(request.resource.data.precio_costo)
                            && isOptionalString(request.resource.data, 'descripcion', 1000)
                            && isOptionalString(request.resource.data, 'barcode', 100);
      allow delete: if isAdmin();
    }

    // --- KARDEX (inmutable y atribuido al usuario real) ---
    match /movimientos_inventario/{movId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.tipo in ['ENTRADA', 'SALIDA']
                    && isNonNegativeNumber(request.resource.data.cantidad)
                    && request.resource.data.cantidad > 0;
      allow update, delete: if false;
    }

    // --- VENTAS ---
    match /ventas/{ventaId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.createdBy == request.auth.uid
                    && isNonEmptyString(request.resource.data.cliente, 200)
                    && isNonNegativeNumber(request.resource.data.total)
                    && request.resource.data.monto_pagado == 0;
      allow update: if isAdmin()
                    && isNonNegativeNumber(request.resource.data.monto_pagado)
                    && request.resource.data.monto_pagado <= request.resource.data.total
                    && request.resource.data.total == resource.data.total
                    && request.resource.data.items == resource.data.items;
      allow delete: if isAdmin();
    }

    // --- PRESUPUESTOS / CLIENTES / PROVEEDORES / COMPRAS ---
    match /presupuestos/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /clientes/{clienteId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /proveedores/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && isNonEmptyString(request.resource.data.nombre, 200);
      allow delete: if isAdmin();
    }
    match /compras/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isNonNegativeNumber(request.resource.data.total);
      allow update, delete: if isAdmin();
    }

    // --- FINANZAS ---
    match /gastos/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && isNonNegativeNumber(request.resource.data.monto)
                            && request.resource.data.fecha is timestamp;
      allow delete: if isAdmin();
    }

    // --- CORRELATIVOS (folios) ---
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // --- RRHH ---
    match /trabajadores/{docId} {
      allow read, write: if isAdmin();
    }
    match /asistencias/{docId} {
      allow read, write: if isAdmin();
    }
    match /registros_produccion/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
