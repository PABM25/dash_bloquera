rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // MODELO DE ACCESO (menor privilegio, denegar por defecto)
    //   ADMIN -> lectura y escritura total
    //   cualquier otro rol (user, DESACTIVADO, sin perfil) -> sin acceso
    // El rol vive en users/{uid}.role y solo un ADMIN puede asignarlo.
    // Toda colección no listada aquí queda denegada.
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return exists(userDoc()) ? get(userDoc()).data.get('role', '') : '';
    }

    function isAdmin() {
      return isSignedIn() && role() == 'ADMIN';
    }

    // BLOQUERO: solo registra su producción (ver productos y registros_produccion).
    function isBloquero() {
      return isSignedIn() && role() == 'BLOQUERO';
    }

    // Ficha de RRHH vinculada a la cuenta (la asigna un ADMIN).
    function miTrabajadorId() {
      return get(userDoc()).data.get('trabajadorId', '');
    }

    function validRole(r) {
      return r in ['ADMIN', 'BLOQUERO', 'DESACTIVADO'];
    }

    // El bloquero solo puede subir el stock de un producto exactamente en la
    // cantidad de un registro de producción suyo creado en el mismo batch.
    function produccionValida(productoId, registroId, delta) {
      let ruta = /databases/$(database)/documents/registros_produccion/$(registroId);
      return !exists(ruta) && existsAfter(ruta)
          && getAfter(ruta).data.uid == request.auth.uid
          && getAfter(ruta).data.productoId == productoId
          && getAfter(ruta).data.cantidad == delta;
    }

    // Registro de producción: del propio usuario, con la tarifa del producto
    // y sumando exactamente esa cantidad al stock en el mismo batch.
    function registroProduccionValido(registroId) {
      let d = request.resource.data;
      let prod = /databases/$(database)/documents/productos/$(d.productoId);
      let tarifa = get(prod).data.get('tarifa_produccion', 0);
      return d.uid == request.auth.uid
          && miTrabajadorId() != ''
          && d.trabajadorId == miTrabajadorId()
          && d.cantidad is int && d.cantidad > 0 && d.cantidad <= 10000
          && (tarifa is int || tarifa is float) && tarifa > 0
          && d.tarifa == tarifa
          && d.monto == d.cantidad * tarifa
          && d.fecha == request.time
          // Hora del teléfono: se tolera hasta 7 días sin señal, no fechas futuras.
          && d.fecha_local is timestamp
          && d.fecha_local > request.time - duration.value(7, 'd')
          && d.fecha_local < request.time + duration.value(1, 'h')
          && getAfter(prod).data.stock == get(prod).data.stock + d.cantidad
          && getAfter(prod).data.get('ultima_produccion', '') == registroId;
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    function isNonNegativeNumber(v) {
      return (v is int || v is float) && v >= 0;
    }

    // --- USUARIOS ---
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Solo un ADMIN crea perfiles y asigna roles (no hay auto-registro)
      allow create: if isAdmin()
                    && validRole(request.resource.data.role)
                    && isNonEmptyString(request.resource.data.nombre, 100);
      // Solo ADMIN modifica perfiles (nombre y rol)
      allow update: if isAdmin()
                    && validRole(request.resource.data.role)
                    && isNonEmptyString(request.resource.data.nombre, 100);
      allow delete: if false;
    }

    // --- PRODUCTOS ---
    match /productos/{productoId} {
      allow read: if isAdmin() || isBloquero();
      allow create, update: if isAdmin()
                            && isNonEmptyString(request.resource.data.nombre, 200)
                            && isNonNegativeNumber(request.resource.data.stock)
                            && isNonNegativeNumber(request.resource.data.precio_costo)
                            && isOptionalString(request.resource.data, 'descripcion', 1000)
                            && isOptionalString(request.resource.data, 'barcode', 100)
                            && (!('tarifa_produccion' in request.resource.data)
                                || request.resource.data.tarifa_produccion == null
                                || isNonNegativeNumber(request.resource.data.tarifa_produccion));
      // Bloquero: solo sube stock, ligado a su registro de producción.
      allow update: if isBloquero()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['stock', 'ultima_produccion'])
                    && produccionValida(productoId,
                                        request.resource.data.ultima_produccion,
                                        request.resource.data.stock - resource.data.stock);
      allow delete: if isAdmin();
    }

    // --- KARDEX (inmutable y atribuido al usuario real) ---
    match /movimientos_inventario/{movId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.tipo in ['ENTRADA', 'SALIDA']
                    && isNonNegativeNumber(request.resource.data.cantidad)
                    && request.resource.data.cantidad > 0;
      // Bloquero: solo la entrada de su producción.
      allow create: if isBloquero()
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.tipo == 'ENTRADA'
                    && request.resource.data.motivo == 'PRODUCCION'
                    && request.resource.data.cantidad is int
                    && request.resource.data.cantidad > 0;
      allow update, delete: if false;
    }

    // --- VENTAS ---
    match /ventas/{ventaId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.createdBy == request.auth.uid
                    && isNonEmptyString(request.resource.data.cliente, 200)
                    && isNonNegativeNumber(request.resource.data.total)
                    && request.resource.data.monto_pagado == 0;
      allow update: if isAdmin()
                    && isNonNegativeNumber(request.resource.data.monto_pagado)
                    && request.resource.data.monto_pagado <= request.resource.data.total
                    && request.resource.data.total == resource.data.total
                    && request.resource.data.items == resource.data.items;
      allow delete: if isAdmin();
    }

    // --- PRESUPUESTOS / CLIENTES / PROVEEDORES / COMPRAS ---
    match /presupuestos/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /clientes/{clienteId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /proveedores/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && isNonEmptyString(request.resource.data.nombre, 200);
      allow delete: if isAdmin();
    }
    match /compras/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isNonNegativeNumber(request.resource.data.total);
      allow update, delete: if isAdmin();
    }

    // --- FINANZAS ---
    match /gastos/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
                            && isNonNegativeNumber(request.resource.data.monto)
                            && request.resource.data.fecha is timestamp;
      allow delete: if isAdmin();
    }

    // --- CORRELATIVOS (folios) ---
    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && docId != 'ajustes';
    }

    // --- AJUSTES COMPARTIDOS (tasa de IVA de todos los dispositivos) ---
    match /config/ajustes {
      allow write: if isAdmin()
                   && isNonNegativeNumber(request.resource.data.tasa_iva)
                   && request.resource.data.tasa_iva <= 1;
    }

    // --- RRHH ---
    match /trabajadores/{docId} {
      allow read, write: if isAdmin();
    }
    match /asistencias/{docId} {
      allow read, write: if isAdmin();
    }
    // Producción para el pago por unidad. Inmutable: los errores los anula
    // (borra) un ADMIN.
    match /registros_produccion/{docId} {
      allow read: if isAdmin()
                  || (isBloquero() && resource.data.uid == request.auth.uid);
      allow create: if isBloquero() && registroProduccionValido(docId);
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
